# Copie para .env e preencha. NUNCA versione o arquivo .env.
PORT=3000
NODE_ENV=development
# Gere um segredo longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Origens permitidas para CORS/Socket.IO, separadas por vírgula (vazio = apenas mesma origem)
ALLOWED_ORIGINS=
